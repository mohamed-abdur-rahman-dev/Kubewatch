# API service environment variables
# Copy to .env and fill in values before running.

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# How often the k8s pod cache refreshes (seconds)
COLLECT_INTERVAL=15
POD_CACHE_TTL=10

# URL of the ai-service (apps/ai-service)
AI_SERVICE_URL=http://localhost:8001

# How long to cache the last LLM insight (seconds)
INSIGHT_CACHE_TTL=20
