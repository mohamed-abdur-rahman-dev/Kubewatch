# apps/dashboard/.env.example
# Copy to .env and set values before running npm dev.
# Vite only exposes variables with the VITE_ prefix to the browser.
# Never put secrets here — this file is committed to git.

# URL of the API service (apps/api)
VITE_API_URL=http://localhost:8000

# How often the pod table refreshes (ms) — matches usePods.js POLL_INTERVAL
VITE_POLL_INTERVAL_MS=15000

# How often the insight panel refreshes for Ollama (ms) — matches useInsights.js OLLAMA_POLL
VITE_INSIGHT_POLL_MS=60000
