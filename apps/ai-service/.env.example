# AI service environment variables
# Copy to .env and fill in values before running.

HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info

# Ollama settings (local inference)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=90

# OpenAI settings (cloud inference — optional)
# Leave OPENAI_API_KEY blank to use local Ollama only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
